# =====================================================================
# Campus Connect — Environment Variables Reference
# =====================================================================

# 1. SERVER CONFIGURATION
# Local / Hosting Server Port (Default is 3000 if omitted)
# Cloud platforms (Vercel, Render, Railway) automatically inject this.
PORT=3000

# 2. SUPABASE (OPTIONAL)
# NOTE: Campus Connect currently runs a standalone, zero-dependency 
# database via data/clubs.json and data/users.json with atomic persistence.
# Supabase is NOT required to deploy or test the app!
#
# If you choose to connect Supabase in the future:
# 1. Sign up at https://supabase.com and create a new project.
# 2. Go to Project Settings -> API.
# 3. Copy your "Project URL" and "anon public" API key below:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-api-key-here
